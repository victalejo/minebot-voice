# MineBot dashboard

# AI provider: "anthropic" (default) or "openai" (for OpenAI-compatible APIs like DeepSeek, MiniMax)
# AI_PROVIDER=openai

# --- Anthropic provider ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- OpenAI-compatible provider (e.g. DeepSeek V4) ---
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-your-deepseek-key
# AI_MODEL=deepseek-v4-flash               # used by command parser
# json_object (default, works with DeepSeek) or json_schema (OpenAI/MiniMax strict mode)
# OPENAI_JSON_MODE=json_object
# DeepSeek V4 Pro thinking (ignored by Flash). Values: enabled | disabled
# OPENAI_THINKING=enabled
# OPENAI_REASONING_EFFORT=high             # low | medium | high | max

# --- Goal planner (autonomous decision-making, fase 3) ---
# PLANNER_ENABLED=true                     # set to false to disable autonomous goal proposals
# PLANNER_MODEL=deepseek-v4-pro            # defaults to AI_MODEL if not set; pro recommended
# PLANNER_THINKING=enabled                 # defaults to OPENAI_THINKING; enable for better plans
# PLANNER_REASONING_EFFORT=high            # defaults to OPENAI_REASONING_EFFORT

ACCESS_PASSWORD=your-secret-password
JWT_SECRET=generate-a-random-string-here

# Minecraft server connection
MINECRAFT_HOST=minecraft
MINECRAFT_PORT=25565
BOT_USERNAME=MineBot
# Display name the bot answers to in chat. Defaults to BOT_USERNAME.
# Players can say e.g. "Juan, consigue madera" and the bot will respond.
# BOT_NAME=Juan

# Optional: chat-based auth plugin (AuthMe/LoginSecurity/etc on cracked servers).
# If set, the bot will chat this string as plain text right after spawn to log in.
# MC_AUTH_PASSWORD=jugar123

# Security: allowed CORS origins (comma-separated). Leave empty to block cross-origin.
# ALLOWED_ORIGINS=https://minebot.yourdomain.com

# Minecraft server (only for docker-compose.server.yml)
# Comma-separated, no spaces: Player1,Player2,MineBot
MC_WHITELIST=YourName,MineBot
MC_OPS=YourName,MineBot

# Data persistence
DB_PATH=./data/minebot.sqlite
MEMORY_DIR=./data/memories
